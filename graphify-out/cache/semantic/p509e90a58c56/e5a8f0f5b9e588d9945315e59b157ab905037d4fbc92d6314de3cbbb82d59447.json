{"nodes": [{"id": "anti_patterns", "label": "Anti-patterns", "file_type": "document", "source_file": "midia-ia/ia/skills/viral-short-form-ideas/references/anti-patterns.md", "rationale": "Catalog of common ideation failure modes (e.g., over-tooling, copying without re-angling) and their structural fixes."}, {"id": "references_anti_patterns_brainstorming_without_constraints", "label": "Brainstorming without constraints", "file_type": "concept", "source_file": "midia-ia/ia/skills/viral-short-form-ideas/references/anti-patterns.md", "rationale": "Identified as a failure mode where the brain free-associates instead of triangulating, leading to generic ideas."}, {"id": "references_anti_patterns_copying_without_re_angling", "label": "Copying without re-angling", "file_type": "concept", "source_file": "midia-ia/ia/skills/viral-short-form-ideas/references/anti-patterns.md", "rationale": "Failure mode where creators copy surface details of competitors instead of extracting the underlying mechanic (Galloway's rule)."}, {"id": "references_anti_patterns_idea_wall_problem", "label": "The idea-wall problem", "file_type": "concept", "source_file": "midia-ia/ia/skills/viral-short-form-ideas/references/anti-patterns.md", "rationale": "Capture without execution leads to an overwhelming backlog and flat publish cadence."}, {"id": "references_anti_patterns_niching_too_narrow", "label": "Niching too narrow", "file_type": "concept", "source_file": "midia-ia/ia/skills/viral-short-form-ideas/references/anti-patterns.md", "rationale": "Causes idea drought and burnout when the niche cannot sustain long-term output."}, {"id": "references_anti_patterns_niching_too_broad", "label": "Niching too broad", "file_type": "concept", "source_file": "midia-ia/ia/skills/viral-short-form-ideas/references/anti-patterns.md", "rationale": "Leads to flat engagement because the algorithm and audience lack clarity on the account's purpose."}, {"id": "references_anti_patterns_inspiration_over_system", "label": "Inspiration over system", "file_type": "concept", "source_file": "midia-ia/ia/skills/viral-short-form-ideas/references/anti-patterns.md", "rationale": "Relying on inspiration causes inconsistent output; prolific creators use scheduled systems."}, {"id": "references_anti_patterns_producing_before_testing", "label": "Producing before testing", "file_type": "concept", "source_file": "midia-ia/ia/skills/viral-short-form-ideas/references/anti-patterns.md", "rationale": "Inverts the cost-test ratio by spending high effort on unvalidated ideas (Hormozi's ladder)."}, {"id": "references_anti_patterns_hook_as_afterthought", "label": "Treating the hook as an afterthought", "file_type": "concept", "source_file": "midia-ia/ia/skills/viral-short-form-ideas/references/anti-patterns.md", "rationale": "The hook is the viability filter; writing it last risks wasting production on weak ideas."}, {"id": "references_anti_patterns_over_tooling", "label": "Over-tooling", "file_type": "concept", "source_file": "midia-ia/ia/skills/viral-short-form-ideas/references/anti-patterns.md", "rationale": "Productivity theater where tool sophistication is inversely correlated with actual output."}, {"id": "references_anti_patterns_mixing_modes", "label": "Mixing capture and creation modes", "file_type": "concept", "source_file": "midia-ia/ia/skills/viral-short-form-ideas/references/anti-patterns.md", "rationale": "Capture is low-judgment/fast; creation is high-judgment/slow. Mixing them fragments focus."}, {"id": "references_anti_patterns_untested_series", "label": "Building a series without testing the premise", "file_type": "concept", "source_file": "midia-ia/ia/skills/viral-short-form-ideas/references/anti-patterns.md", "rationale": "Committing to long-form series before validating if the premise is durable."}, {"id": "frameworks", "label": "frameworks.md", "file_type": "document", "source_file": "midia-ia/ia/skills/viral-short-form-ideas/references/anti-patterns.md", "metadata": {"graphify_reference_stub": true}}, {"id": "idea_evaluation", "label": "idea-evaluation.md", "file_type": "document", "source_file": "midia-ia/ia/skills/viral-short-form-ideas/references/anti-patterns.md", "metadata": {"graphify_reference_stub": true}}, {"id": "assets_idea_tracker", "label": "assets/idea-tracker.md", "file_type": "document", "source_file": "midia-ia/ia/skills/viral-short-form-ideas/references/anti-patterns.md", "metadata": {"graphify_reference_stub": true}}, {"id": "pillars", "label": "pillars.md", "file_type": "document", "source_file": "midia-ia/ia/skills/viral-short-form-ideas/references/anti-patterns.md", "metadata": {"graphify_reference_stub": true}}, {"id": "repurposing", "label": "repurposing.md", "file_type": "document", "source_file": "midia-ia/ia/skills/viral-short-form-ideas/references/anti-patterns.md", "metadata": {"graphify_reference_stub": true}}, {"id": "mining", "label": "mining.md", "file_type": "document", "source_file": "midia-ia/ia/skills/viral-short-form-ideas/references/anti-patterns.md", "metadata": {"graphify_reference_stub": true}}], "edges": [{"source": "anti_patterns", "target": "frameworks", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "midia-ia/ia/skills/viral-short-form-ideas/references/anti-patterns.md"}, {"source": "anti_patterns", "target": "idea_evaluation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "midia-ia/ia/skills/viral-short-form-ideas/references/anti-patterns.md"}, {"source": "anti_patterns", "target": "pillars", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "midia-ia/ia/skills/viral-short-form-ideas/references/anti-patterns.md"}, {"source": "anti_patterns", "target": "repurposing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "midia-ia/ia/skills/viral-short-form-ideas/references/anti-patterns.md"}, {"source": "anti_patterns", "target