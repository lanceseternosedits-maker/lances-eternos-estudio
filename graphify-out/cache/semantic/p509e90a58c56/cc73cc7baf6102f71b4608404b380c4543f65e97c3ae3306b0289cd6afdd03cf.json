{"nodes": [{"id": "midia_ia_ia_skills_viral_youtube_shorts_references_shorts_anti_patterns", "label": "Shorts Anti-Patterns Reference", "file_type": "document", "source_file": "midia-ia/ia/skills/viral-youtube-shorts/references/shorts-anti-patterns.md", "rationale": "Lists common mistakes like watermarks, wrong aspect ratios, and 'Subscribe' CTAs."}, {"id": "midia_ia_ia_skills_viral_youtube_shorts_references_shorts_anti_patterns", "label": "Shorts Anti-patterns Reference", "file_type": "document", "source_file": "midia-ia/ia/skills/viral-youtube-shorts/references/shorts-anti-patterns.md", "rationale": "Lists patterns that hurt performance on YouTube Shorts."}, {"id": "shorts_anti_patterns_shorts_anti_patterns", "label": "Shorts Anti-Patterns", "file_type": "document", "source_file": "midia-ia/ia/skills/viral-youtube-shorts/references/shorts-anti-patterns.md"}, {"id": "shorts_anti_patterns_tiktok_watermark", "label": "TikTok Watermark", "file_type": "concept", "source_file": "midia-ia/ia/skills/viral-youtube-shorts/references/shorts-anti-patterns.md", "rationale": "Detected watermarks cause demotion in distribution as they are read as low-effort repurposing."}, {"id": "shorts_anti_patterns_aspect_ratio", "label": "16:9 Horizontal with Vertical Bars", "file_type": "concept", "source_file": "midia-ia/ia/skills/viral-youtube-shorts/references/shorts-anti-patterns.md", "rationale": "YouTube classifies horizontal video with bars as long-form, preventing entry into the Shorts Feed."}, {"id": "shorts_anti_patterns_subscribe_cta", "label": "Subscribe! CTA", "file_type": "concept", "source_file": "midia-ia/ia/skills/viral-youtube-shorts/references/shorts-anti-patterns.md", "rationale": "Pulls retention down and doesn't lift sub rates because the UI already places a button there."}, {"id": "shorts_anti_patterns_intros", "label": "Welcome-back / Logo / Animated Intros", "file_type": "concept", "source_file": "midia-ia/ia/skills/viral-youtube-shorts/references/shorts-anti-patterns.md", "rationale": "Delays the hook and tanks VVSA (Viewed vs Swiped Away) in the critical first 3 seconds."}, {"id": "shorts_anti_patterns_trending_sound", "label": "Trending Sound on Small Channels", "file_type": "concept", "source_file": "midia-ia/ia/skills/viral-youtube-shorts/references/shorts-anti-patterns.md", "rationale": "Channels under 50k subs perform better with original audio as a freshness signal and to avoid revenue cuts."}, {"id": "shorts_anti_patterns_safe_zone", "label": "Captions Outside Safe Zone", "file_type": "concept", "source_file": "midia-ia/ia/skills/viral-youtube-shorts/references/shorts-anti-patterns.md", "rationale": "YouTube UI covers top 20% and bottom 25%; captions must be in the middle third."}, {"id": "shorts_anti_patterns_mass_produced", "label": "Mass-produced / Repetitious Content", "file_type": "concept", "source_file": "midia-ia/ia/skills/viral-youtube-shorts/references/shorts-anti-patterns.md", "rationale": "Violates YPP guidelines; low-effort AI or stock footage spam loses monetization."}, {"id": "shorts_anti_patterns_off_topic", "label": "Off-topic Shorts Tab", "file_type": "concept", "source_file": "midia-ia/ia/skills/viral-youtube-shorts/references/shorts-anti-patterns.md", "rationale": "Unrelated recent shorts drop conversion when a viewer visits the channel after a viral hit."}, {"id": "shorts_anti_patterns_view_confusion", "label": "Confusing Views with Engaged Views", "file_type": "concept", "source_file": "midia-ia/ia/skills/viral-youtube-shorts/references/shorts-anti-patterns.md", "rationale": "Raw views include instant plays/loops; Engaged Views are the quality signal for monetization."}, {"id": "shorts_anti_patterns_length_ceiling", "label": "3-minute Ceiling Without Reason", "file_type": "concept", "source_file": "midia-ia/ia/skills/viral-youtube-shorts/references/shorts-anti-patterns.md", "rationale": "Stretching length hurts average percentage viewed; 30-45s is the sweet spot."}, {"id": "shorts_to_longform_funnel", "label": "Shorts to Longform Funnel", "file_type": "document", "source_file": "midia-ia/ia/skills/viral-youtube-shorts/references/shorts-anti-patterns.md", "metadata": {"graphify_reference_stub": true}}], "edges": [{"source": "midia_ia_ia_skills_viral_youtube_shorts_references_shorts_anti_patterns", "target": "midia_ia_ia_skills_viral_youtube_shorts_references_shorts_to_longform_funnel", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "midia-ia/ia/skills/viral-youtube-shorts/references/shorts-anti-patterns.md"}, {"source": "midia_ia_ia_skills_viral_youtube_shorts_references_shorts_anti_patterns", "target": "midia_ia_ia_skills_viral_youtube_shorts_references_shorts_monetization", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "midia-ia/ia/skills/viral-youtube-shorts/references/shorts-anti-patterns.md"}, {"source": "shorts_anti_patterns_shorts_anti_patterns", "target": "shorts_anti_patterns_tiktok_watermark", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "midia-ia/ia/skills/viral-youtube-shorts/references/shorts-anti-patterns.md"}, {"source": "shorts_anti_patterns_shorts_anti_patterns", "target": "shorts_anti_patterns_aspect_ratio", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "midia-ia/ia/skills/viral-youtube-shorts/references/shorts-anti-patterns.md"}, {"source": "shorts_anti_patterns_shorts_anti_patterns", "target": "shorts_anti_patterns_subscribe_cta", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "midia-ia/ia/skills/viral-youtube-shorts/references/shorts-anti-patterns.md"}, {"source": "shorts_anti_patterns_shorts_anti_patterns", "target": "shorts_anti_patterns_intros", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "midia-ia/ia/skills/viral-youtube-shorts/references/shorts-anti-patte