+import { mkdtempSync, statSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { describe, expect, it, vi } from 'vitest';
+import { isDemoId } from '../../shared/timeline';
+import { EQUIPE, EquipeSource, equipeSnapshot, loadCredential, parseEm, saveCredential, STALE_MS, type EquipeUpdate } from './equipe';
+
+// 11/11/2026 10:00 em Brasília = 13:00 UTC
+const NOW = Date.UTC(2026, 10, 11, 13, 0);
+
+describe('equipe IA em 60s', () => {
+  it('lê o horário do painel (Brasília, UTC−3)', () => {
+    expect(parseEm('2026-11-11 10:00')).toBe(NOW);
+    expect(Number.isNaN(parseEm('ontem'))).toBe(true);
+  });
+
+  it('monta um personagem por agente, nas salas por setor, com ids fora do World', () => {
+    const { snap } = equipeSnapshot(
+      { agentes: { estudio: { agente: 'estudio', estado: 'trabalhando', detalhe: 'renderizando reels', progresso: '3/5', em: '2026-11-11 09:50' } } },
+      NOW,
+      NOW - 60_000,
+    );
+    expect(snap.agents).toHaveLength(EQUIPE.length);
+    expect(snap.rooms.map((r) => r.name)).toEqual(['Produção', 'Resultados', 'Vendas e DMs']);
+    for (const a of snap.agents) {
+      expect(isDemoId(a.id)).toBe(true);
+      expect(isDemoId(a.roomId)).toBe(true);
+      expect(snap.rooms.some((r) => r.id === a.roomId)).toBe(true);
+    }
+    expect(isDemoId(snap.accounts[0].id)).toBe(true);
+    const est = snap.agents.find((a) => a.name === 'Estúdio')!;
+    expect(est.status).toBe('working');
+    expect(est.activity?.text).toBe('renderizando reels (3/5)');
+    expect(est.tasks[0].title).toContain('3/5');
+    expect(snap.agents.find((a) => a.name === 'Caçador')!.status).toBe('idle');
+  });
+
+  it('trabalhando há mais de 3 h sem atualizar vira "parado?" (mão levantada)', () => {
+    const em = new Date(NOW - STALE_MS - 3_600_000 - 3 * 3_600_000).toISOString().slice(0, 16).replace('T', ' ');
+    const { snap } = equipeSnapshot({ agentes: { analista: { agente: 'analista', estado: 'trabalhando', detalhe: 'lendo métricas', em } } }, NOW, NOW);
+    const a = snap.agents.find((x) => x.name === 'Analista')!;
+    expect(a.status).toBe('waiting');
+    expect(a.waitingFor).toMatch(/parado\?.*4 h/);
+  });
+
+  it('guarda a sessão com permissão 600', () => {
+    const dir = mkdtempSync(join(tmpdir(), 'equipe-'));
+    const file = saveCredential(dir, { url: 'https://painel.exemplo', cookie: 'abc', savedAt: 'x' });
+    expect(statSync(file).mode & 0o777).toBe(0o600);
+    expect(loadCredential(dir, {})?.cookie).toBe('abc');
+    expect(loadCredential(dir, { HABBLAUD_EQUIPE_COOKIE: 's=zzz' })?.cookie).toBe('zzz');
+  });
+
+  it('avisa quando alguém começa, termina ou para, e para de tentar sem login', async () => {
+    let body: unknown = { agentes: {} };
+    let status = 200;
+    const fetchImpl = vi.fn(async () => new Response(JSON.stringify(body), { status })) as unknown as typeof fetch;
+    const updates: EquipeUpdate[] = [];
+    const warn = vi.fn();
+    let now = NOW;
+    const src = new EquipeSource({ cred: { url: 'https://p', cookie: 'c', savedAt: '' }, onUpdate: (u) => updates.push(u), log: { info: () => {}, warn }, fetchImpl, now: () => now });
+    await src.poll(true);
+    expect(updates[0].feed).toHaveLength(0);
+    body = { agentes: { roteirista: { agente: 'roteirista', estado: 'trabalhando', detalhe: 'escrevendo roteiros', progresso: '2/28', em: '2026-11-11 10:00' } } };
+    await src.poll();
+    expect(updates[1].feed.map((f) => f.agentName)).toEqual(['Roteirista']);
+    expect(updates[1].notices[0].text).toMatch(/Roteirista começou/);
+    body = { agentes: { roteirista: { agente: 'roteirista', estado: 'livre', detalhe: '28 roteiros prontos', em: '2026-11-11 10:30' } } };
+    now += 30 * 60_000;
+    await src.poll();
+    expect(updates[2].notices[0]).toMatchObject({ level: 'success' });
+    status = 401;
+    await src.poll();
+    await src.poll();
+    expect(updates).toHaveLength(3);
+    expect(warn).toHaveBeenCalledTimes(1);
+    expect(warn.mock.calls[0][0]).toMatch(/equipe:login/);
+  });
+});
