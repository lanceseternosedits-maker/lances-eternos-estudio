@@ -500,8 +512,47 @@ export class OfficeStore {
   /** Simulador do modo ?mock=1 (também responde os pedidos de permissão fictícios). */
   private mockSim: DemoSimulator | null = null;
 
+  private readonly equipeUrl: string;
+  private equipePrev = new Map<string, EquipeState>();
+  private readonly equipeSeq = { n: 0 };
+  private readonly equipeStart = Date.now();
+  /** Último erro da leitura da equipe ('' = ok), para avisar uma vez só. */
+  private equipeErr = '';
+
+  private startEquipe(): void {
+    this.setConnection('mock');
+    const poll = async (): Promise<void> => {
+      let data: AtividadeResponse;
+      try {
+        const res = await fetch(this.equipeUrl, { cache: 'no-store', credentials: 'same-origin' });
+        if (res.status === 401) throw new Error(tr('Entre no painel de novo para ver a equipe.'));
+        if (!res.ok) throw new Error(tr('O painel respondeu {0}.', [String(res.status)]));
+        data = (await res.json()) as AtividadeResponse;
+      } catch (err) {
+        const msg = err instanceof Error ? err.message : String(err);
+        if (msg !== this.equipeErr) this.emit('notice', { id: `equipe-erro-${Date.now()}`, level: 'warn', text: msg, at: Date.now() });
+        this.equipeErr = msg;
+        return;
+      }
+      this.equipeErr = '';
+      const now = Date.now();
+      const { snap, states } = equipeSnapshot(data, now, this.equipeStart);
+      const { feed, notices } = diffEquipe(this.equipePrev, states, now, this.equipeSeq);
+      this.equipePrev = states;
+      // Sem a "conta" da equipe: dentro do painel só existe ela, e o cartão de uso (5 h / semana) não se aplica.
+      this.applySnapshot({ ...snap, accounts: [], rev: this.equipeSeq.n + 1 });
+      if (feed.length) this.applyFeed(feed);
+      notices.forEach((n) => this.emit('notice', n));
+    };
+    void poll();
+    this.mockTimer = setInterval(() => void poll(), EQUIPE_POLL_MS);
+    // Voltando ao app (celular desbloqueado, aba de volta): lê na hora em vez de esperar o próximo intervalo.
+    if (typeof document !== 'undefined') document.addEventListener('visibilitychange', () => document.visibilityState === 'visible' && void poll());
+  }
+
   private startMock(): void {
     if (this.mockTimer) return;
+    if (this.equipe) return this.startEquipe();
     this.setConnection('mock');
     const sim = new DemoSimulator(mockOptionsFrom(this.search));
     this.mockSim = sim;
