+++ b/server/sources/equipe.ts
@@ -0,0 +1,113 @@
+// Equipe IA em 60s no servidor: lê GET /api/atividade do painel (atrás do login por código no celular) a cada poucos
+// segundos e entrega ao Office um snapshot só com a equipe, misturado aos agentes reais como o modo demonstração.
+// A parte pura (quem é quem, salas, conversão) está em shared/equipe.ts.
+
+import { chmodSync, existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
+import { dirname, join } from 'node:path';
+import { DEFAULT_EQUIPE_URL, diffEquipe, equipeSnapshot, POLL_MS, type AtividadeResponse, type EquipeState } from '../../shared/equipe';
+import type { FeedItem, Notice, OfficeSnapshot } from '../../shared/types';
+
+export * from '../../shared/equipe';
+
+// ---------------------------------------------------------------- credencial (cookie do painel)
+
+export interface EquipeCredential {
+  url: string;
+  cookie: string;
+  savedAt: string;
+}
+
+export const credentialPath = (dataDir: string): string => join(dataDir, 'equipe.json');
+
+export function loadCredential(dataDir: string, env: NodeJS.ProcessEnv = process.env): EquipeCredential | undefined {
+  const url = (env.HABBLAUD_EQUIPE_URL?.trim() || DEFAULT_EQUIPE_URL).replace(/\/+$/, '');
+  const fromEnv = env.HABBLAUD_EQUIPE_COOKIE?.trim();
+  if (fromEnv) return { url, cookie: fromEnv.replace(/^s=/, ''), savedAt: '' };
+  const file = credentialPath(dataDir);
+  if (!existsSync(file)) return undefined;
+  try {
+    const c = JSON.parse(readFileSync(file, 'utf8')) as Partial<EquipeCredential>;
+    return c.cookie ? { url: (c.url || url).replace(/\/+$/, ''), cookie: c.cookie, savedAt: c.savedAt ?? '' } : undefined;
+  } catch {
+    return undefined;
+  }
+}
+
+export function saveCredential(dataDir: string, cred: EquipeCredential): string {
+  const file = credentialPath(dataDir);
+  mkdirSync(dirname(file), { recursive: true, mode: 0o700 });
+  writeFileSync(file, JSON.stringify(cred, null, 2) + '\n', { mode: 0o600 });
+  chmodSync(file, 0o600);
+  return file;
+}
+
+// ---------------------------------------------------------------- a fonte
+
+export interface EquipeUpdate {
+  snap: OfficeSnapshot | null;
+  feed: FeedItem[];
+  notices: Notice[];
+}
+
+export interface EquipeSourceOptions {
+  cred: EquipeCredential;
+  onUpdate: (u: EquipeUpdate) => void;
+  log: { info: (m: string) => void; warn: (m: string) => void };
+  fetchImpl?: typeof fetch;
+  now?: () => number;
+  intervalMs?: number;
+}
+
+/** Lê /api/atividade do painel em intervalos e avisa o Office do que mudou. */
+export class EquipeSource {
+  private timer: NodeJS.Timeout | null = null;
+  private prev = new Map<string, EquipeState>();
+  private readonly startedAt: number;
+  private readonly now: () => number;
+  private failing = '';
+  private seq = { n: 0 };
+
+  constructor(private readonly o: EquipeSourceOptions) {
+    this.now = o.now ?? Date.now;
+    this.startedAt = this.now();
+  }
+
+  start(): void {
+    if (this.timer) return;
+    void this.poll(true);
+    this.timer = setInterval(() => void this.poll(false), this.o.intervalMs ?? POLL_MS);
+    this.timer.unref?.();
+  }
+
+  stop(): void {
+    if (this.timer) clearInterval(this.timer);
+    this.timer = null;
+  }
+
+  async poll(first = false): Promise<void> {
+    let data: AtividadeResponse;
+    try {
+      const r = await (this.o.fetchImpl ?? fetch)(`${this.o.cred.url}/api/atividade`, {
+        headers: { cookie: `s=${this.o.cred.cookie}`, accept: 'application/json' },
+        redirect: 'manual',
+        signal: AbortSignal.timeout(10_000),
+      });
+      if (r.status === 401 || (r.status >= 300 && r.status < 400)) throw new Error('login vencido: rode `npm run equipe:login` de novo');
+      if (!r.ok) throw new Error(`o painel respondeu ${r.status}`);
+      data = (await r.json()) as AtividadeResponse;
+    } catch (err) {
+      const msg = err instanceof Error ? err.message : String(err);
+      if (msg !== this.failing) this.o.log.warn(`Equipe IA em 60s: ${msg}`);
+      this.failing = msg;
+      return;
+    }
+    if (this.failing) this.o.log.info('Equipe IA em 60s: conexão com o painel de volta.');
+    this.failing = '';
+    const now = this.now();
+    const { snap, states } = equipeSnapshot(data, now, this.startedAt);
+    const { feed, notices } = diffEquipe(this.prev, states, now, this.seq);
+    this.prev = states;
+    if (first) this.o.log.info(`Equipe IA em 60s: ${states.size} agentes no prédio (${[...states.values()].filter((s) => s.agent.status === 'working').length} trabalhando).`);
+    this.o.onUpdate({ snap, feed, notices });
+  }
+}
