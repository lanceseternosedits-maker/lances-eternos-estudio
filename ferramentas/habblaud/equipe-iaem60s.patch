+// npm run equipe:login — conecta o Habblaud ao painel da IA em 60s para a equipe aparecer no escritório.
+//
+// Usa o mesmo acesso do painel: o código chega por notificação no celular (o que tem o 🔔 ativado no app), você
+// digita aqui, e a sessão (cookie) fica em ~/.habblaud/equipe.json (permissão 600; ou em HABBLAUD_DATA_DIR).
+// Nada além disso é guardado. `npm run equipe:login -- --sair` apaga a sessão.
+
+import { existsSync, rmSync } from 'node:fs';
+import { homedir } from 'node:os';
+import { join, resolve } from 'node:path';
+import { createInterface } from 'node:readline/promises';
+import { credentialPath, DEFAULT_EQUIPE_URL, saveCredential } from '../server/sources/equipe';
+
+const dataDir = resolve(process.env.HABBLAUD_DATA_DIR?.trim() || join(homedir(), '.habblaud'));
+const url = (process.env.HABBLAUD_EQUIPE_URL?.trim() || DEFAULT_EQUIPE_URL).replace(/\/+$/, '');
+
+async function main(): Promise<void> {
+  if (process.argv.includes('--sair')) {
+    const f = credentialPath(dataDir);
+    if (existsSync(f)) rmSync(f);
+    console.log(`Sessão da equipe apagada (${f}).`);
+    return;
+  }
+  console.log(`🏢 Conectar a equipe IA em 60s (${url})\n`);
+  const pedir = await fetch(`${url}/api/acesso`, { method: 'POST' });
+  const pj = (await pedir.json().catch(() => ({}))) as { erro?: string };
+  if (!pedir.ok) {
+    console.error(`⚠️  Não deu para mandar o código: ${pj.erro ?? `o painel respondeu ${pedir.status}`}`);
+    if (pedir.status !== 429) process.exit(1);
+    console.log('   Se um código chegou há menos de 1 minuto, pode usar ele.');
+  } else {
+    console.log('📲 Código enviado. Veja a notificação "🔐 Código do painel" no celular (vale 10 minutos).');
+  }
+  const rl = createInterface({ input: process.stdin, output: process.stdout });
+  const codigo = (await rl.question('Código de 6 números: ')).trim();
+  rl.close();
+  if (!/^\d{6}$/.test(codigo)) {
+    console.error('⚠️  O código tem 6 números.');
+    process.exit(1);
+  }
+  const entrar = await fetch(`${url}/entrar`, {
+    method: 'POST',
+    body: new URLSearchParams({ codigo }),
+    redirect: 'manual',
+  });
+  const cookie = /(?:^|[;,]\s*)s=([0-9a-f]{16,})/.exec(entrar.headers.get('set-cookie') ?? '')?.[1];
+  if (!cookie) {
+    console.error('⚠️  Código inválido ou vencido. Rode de novo para pedir outro.');
+    process.exit(1);
+  }
+  const teste = await fetch(`${url}/api/atividade`, { headers: { cookie: `s=${cookie}` }, redirect: 'manual' });
+  if (!teste.ok) {
+    console.error(`⚠️  Entrou, mas /api/atividade respondeu ${teste.status}.`);
+    process.exit(1);
+  }
+  const j = (await teste.json()) as { agentes?: Record<string, { estado?: string }> };
+  const file = saveCredential(dataDir, { url, cookie, savedAt: new Date().toISOString() });
+  const n = Object.keys(j.agentes ?? {}).length;
+  const t = Object.values(j.agentes ?? {}).filter((a) => a.estado === 'trabalhando').length;
+  console.log(`\n✅ Conectado. ${n} agentes no painel, ${t} trabalhando agora.`);
+  console.log(`   Sessão guardada em ${file} (vale 1 ano). Reinicie o Habblaud para a equipe entrar no prédio.`);
+}
+
+main().catch((err) => {
+  console.error(`⚠️  ${err instanceof Error ? err.message : String(err)}`);
+  process.exit(1);
+});
